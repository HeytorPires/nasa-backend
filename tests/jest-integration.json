{
    "moduleFileExtensions": [
        "js",
        "json",
        "ts"
    ],
    "rootDir": "..",
    "testEnvironment": "node",
    "transform": {
        "^.+\\.(t|j)s$": "ts-jest"
    },
    "moduleNameMapper": {
        "^src/(.*)$": "<rootDir>/src/$1",
        "^tests/(.*)$": "<rootDir>/tests/$1"
    },
    "setupFiles": [
        "dotenv/config"
    ],
    "testRegex": "\\.integration-spec\\.ts$",
    "globalSetup": "<rootDir>/tests/support/global-setup.ts",
    "testTimeout": 30000,
    "maxWorkers": 1
}
